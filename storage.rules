rules_version = '2';

// BoxSpec — Firebase Storage Rules
// Deploy:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Avatare: avatars/{uid}.jpg
    match /avatars/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && fileName.matches(request.auth.uid + '\\.(jpg|jpeg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Post-Medien: posts/{uid}/{datei}
    match /posts/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*'));
    }

    // Kampfvideos: fights/{uid}/{datei} — privat
    match /fights/{uid}/{fileName} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
